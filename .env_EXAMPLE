NAS_URL=https://192.168.1.100:5001
NAS_USER=api_photo
NAS_PASS=YourPasswordHere
# Optionnal, ID of album to display, if not set, all albums will be displayed
#ALLOWED_ALBUMS=2
GALLERY_TITLE=Your Gallery Title
# Set to true to show GPS locations on approximate OpenStreetMap maps.
# When false, GPS and address metadata is omitted from photo API responses.
# This does not strip metadata embedded in image bytes.
PHOTO_MAP_ENABLED=false
# Disk cache for small image thumbnails (cache hit on later requests).
IMAGE_CACHE_DIR=/app/cache/images
IMAGE_CACHE_MAX_SIZE_MB=512